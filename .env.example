# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* values are sent to the browser. Never put a secret in one.

# Runway (https://dev.runwayml.com)
RUNWAYML_API_SECRET=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase API (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase database (Project > Connect)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Generation limits
# Stops a run before it spends more than this many Runway credits.
RUNWAY_CREDIT_CAP_PER_RUN=500

# Secures the scheduled pipeline endpoint on Vercel.
CRON_SECRET=
